{
  "name": "bilt-builder",
  "version": "1.1.0",
  "description": "Create and manage mobile app projects through the Bilt MCP server.",
  "author": "Bilt",
  "homepage": "https://bilt.me",
  "repository": "https://github.com/buildingapplications/mcp",
  "license": "MIT",
  "category": "development",
  "tags": ["mcp", "app-builder", "mobile", "react-native", "expo"],
  "requirements": {
    "openclaw": ">=0.1.0",
    "features": ["mcp"]
  },
  "setup": [
    {
      "step": 1,
      "action": "Generate an API key at https://bilt.me/settings/api-keys"
    },
    {
      "step": 2,
      "action": "Add the Bilt Streamable HTTP server to openclaw.json"
    },
    {
      "step": 3,
      "action": "Restart the OpenClaw gateway"
    }
  ],
  "config": {
    "mcp": {
      "servers": {
        "bilt": {
          "url": "https://mcp.bilt.me/mcp",
          "transport": "streamable-http",
          "headers": {
            "Authorization": "Bearer bilt_live_YOUR_TOKEN_HERE"
          }
        }
      }
    }
  },
  "tools": [
    "bilt_list_projects",
    "bilt_get_project",
    "bilt_create_project",
    "bilt_get_session",
    "bilt_send_message",
    "bilt_cancel_workflow",
    "bilt_get_messages"
  ],
  "entrypoint": "SKILL.md"
}
